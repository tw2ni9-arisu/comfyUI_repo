# 复制为 .env 或直接写成 RunPod 模板的环境变量

# —— 模型存放位置 ——
# 挂载网络卷后建议指向卷内目录；留空则用镜像内的 $COMFYUI_DIR/models（容器重建会丢）
MODELS_DIR=/workspace/models

# 容器启动时自动下载缺失模型（1=开，0=关）
AUTO_DOWNLOAD_MODELS=1

# Civitai API Key：4 个「需登录才能下载」的文件必须用它
# 生成地址 https://civitai.com/user/account -> API Keys
CIVITAI_TOKEN=

# HuggingFace 国内加速（可选，填 https://hf-mirror.com 时自动改写 HF 直链）
HF_MIRROR=

# 服务端口 / 监听地址
COMFY_PORT=8188
COMFY_LISTEN=0.0.0.0

# 额外传给 main.py 的参数，例如 --lowvram --disable-smart-memory
COMFY_EXTRA_ARGS=

# 模型并发下载数
DOWNLOAD_JOBS=2
